PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for CORS (production example):
# FRONTEND_URL=https://desktalkfrontend.arhamq15.workers.dev
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin JWT (required in production — do not use the default)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Backblaze B2 (S3-compatible)
B2_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET=desktalk-media
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_PUBLIC_URL=https://YOUR_BUCKET.s3.us-west-004.backblazeb2.com

# First admin (used by npm run seed:admin)
ADMIN_EMAIL=admin@desktalk.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Desktalk Admin
